/target
docs/PLAN.md

# Project-local Cargo cache (CARGO_HOME). Ignore the cache, keep a config if added.
/.cargo/*
!/.cargo/config.toml

# Conformance harness TS driver dependencies
tests/conformance/node_modules/

# Generated by `make compile-contracts`; not committed, unlike the older
# fixtures beside it.
devnet/contracts/unshielded-payout/compiled/

# The corpus TS codegen, generated by `make regen-conformance-fixtures`. Only
# the driver reads it, and anyone running the driver has just built it, so it
# stays out of the repository. The analyzed IR beside it is committed because
# `cargo test` reads that one.
tests/conformance/fixtures/*/contract/

# The runtime tarball `make vendor-compact-runtime` builds from the compiler
# submodule. Only the driver installs it, and building it needs the same Nix
# the driver's caller already has.
tests/conformance/ts-driver/vendor/
