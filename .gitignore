/target
docs/PLAN.md

# Project-local Cargo cache (CARGO_HOME). Ignore the cache, keep a config if added.
/.cargo/*
!/.cargo/config.toml
!/.cargo/audit.toml

# Conformance harness TS driver dependencies
tests/conformance/node_modules/

# The compiler output of the test and conformance fixtures, the scratch
# directory of a compile, and the goldens that the TS driver writes from that
# output. `make fixtures goldens` builds each missing or stale one, and CI
# builds them from source on every run.
tests/conformance/fixtures/*/compiler/
tests/conformance/fixtures/*/contract/
tests/conformance/fixtures/*/compiled.tmp/
tests/conformance/expected/
crates/midnight-contract/tests/fixtures/*/compiler/
crates/midnight-contract/tests/fixtures/*/compiled.tmp/
tests/fixtures/compiled/

# The runtime tarball that `make vendor-compact-runtime` builds from
# the compiler fork at COMPACT_REV. Only the driver installs it, and the target
# builds it again on demand.
tests/conformance/ts-driver/vendor/

# The compiled devnet contracts, and the scratch directory of a compile. The
# make targets that need them compile each missing or stale one, and CI
# compiles them from source on every run.
devnet/contracts/*/compiled/
devnet/contracts/*/compiled.tmp/
