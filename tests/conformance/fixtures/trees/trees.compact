// Conformance corpus contract: the Merkle tree operations, whose Impact
// templates rebuild and read the tree root (see issue #192).

import CompactStandardLibrary;

export ledger notes: MerkleTree<4, Bytes<32>>;

// MerkleTree.insert and insertIndex: the `jmp` and `pop` the insertIndex
// template picks the slot with.
export circuit record(item: Bytes<32>, index: Uint<64>): [] {
  notes.insert(disclose(item));
  notes.insertIndex(disclose(item), disclose(index));
}

// checkRoot reads the tree's root and compares it: `root`.
export circuit has_root(digest: Field): Boolean {
  return notes.checkRoot(MerkleTreeDigest { field: disclose(digest) });
}

// isFull compares the first free index against the tree's capacity: `lt`,
// negated into the answer.
export circuit is_full(): Boolean {
  return notes.isFull();
}

// resetToDefault pushes a blank tree inside the array the ADT keeps its
// bookkeeping in.
export circuit reset(): [] {
  notes.resetToDefault();
}
