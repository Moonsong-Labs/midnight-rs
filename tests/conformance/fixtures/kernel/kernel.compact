// Conformance corpus contract: the Kernel operations, whose Impact templates
// reach past the contract's own state into the transaction effects (see
// issue #192), the clock and balance checks, which read the call context, and
// the caller's coin public key.

import CompactStandardLibrary;

// `ckpt` on its own.
export circuit checkpoint_now(): [] {
  kernel.checkpoint();
}

// claimZswapNullifier swaps the effects over the state (`swap`) and inserts
// the nullifier into them.
export circuit claim_nullifier(nul: Bytes<32>): [] {
  kernel.claimZswapNullifier(disclose(nul));
}

// mintShielded accumulates one amount per domain separator, so its template
// tests membership (`neg`, `branch`) and adds onto the amount already
// recorded (`add`).
export circuit mint(domain_sep: Bytes<32>, amount: Uint<64>): [] {
  kernel.mintShielded(disclose(domain_sep), disclose(amount));
}

// The clock checks read the block time from the call context. blockTimeLt
// reads it and then pushes the bound; blockTimeGt pushes the bound first, so
// it reads the context one slot deeper (`dup n:3`).
export circuit block_time_gt(time: Uint<64>): Boolean {
  return blockTimeGt(disclose(time));
}

export circuit block_time_lt(time: Uint<64>): Boolean {
  return blockTimeLt(disclose(time));
}

// The balance check reads the contract balance from the call context, keyed
// by the unshielded token type.
export circuit unshielded_balance_gt(color: Bytes<32>, amount: Uint<128>): Boolean {
  return unshieldedBalanceGt(disclose(color), disclose(amount));
}

// ownPublicKey is a witness-class native, so the prover reads its result as a
// private input.
export circuit caller_coin_public_key(): ZswapCoinPublicKey {
  return disclose(ownPublicKey());
}
