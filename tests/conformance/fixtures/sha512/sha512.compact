// Conformance corpus contract: sha512 over a struct whose fields have
// different widths, so the digest covers the alignment of each field. The
// Makefile compiles this fixture for ZKIR v3 (CONFORMANCE_ZKIR_V3_FIXTURES).

import CompactStandardLibrary;

export ledger digest_cell: Bytes<64>;

export struct Tagged {
  tag: Bytes<32>,
  count: Uint<64>,
}

export circuit sha512_struct(t: Tagged): Bytes<64> {
  const h = sha512<Tagged>(t);
  digest_cell = disclose(h);
  return h;
}
